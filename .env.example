# Telegram
BOT_TOKEN=your_telegram_bot_token
# If your hosting panel reserves BOT_TOKEN, use TELEGRAM_BOT_TOKEN instead.
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# OpenAI
OPENAI_KEY=your_openai_api_key

# Google Calendar
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALENDAR_ID=primary
GOOGLE_REDIRECT_URI=https://yourdomain.com/oauth/callback

# Настройки по умолчанию
DEFAULT_TIMEZONE=Europe/Moscow
REMINDER_TIME=08:00

# База данных (SQLite)
DATABASE_URL=sqlite+aiosqlite:////app/data/bot.db

# Логирование
LOG_LEVEL=INFO

# OAuth режим:
#   local  — для тестирования на localhost (без домена/SSL).
#            Пользователь копирует код из браузера и отправляет боту.
#   server — для продакшна. HTTPS завершается на reverse proxy Bothost.
OAUTH_MODE=local

# HTTP-сервер для OAuth callback (только при OAUTH_MODE=server).
# В панели Bothost внутренний порт должен совпадать с PORT.
WEBHOOK_HOST=0.0.0.0
PORT=8000
