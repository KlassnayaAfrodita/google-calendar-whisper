# Telegram
BOT_TOKEN=your_telegram_bot_token

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Google Calendar
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALENDAR_ID=primary
GOOGLE_REDIRECT_URI=https://yourdomain.com/oauth/callback

# Настройки по умолчанию
DEFAULT_TIMEZONE=Europe/Moscow
REMINDER_TIME=08:00

# База данных (SQLite)
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Логирование
LOG_LEVEL=INFO

# OAuth режим:
#   local  — для тестирования на localhost (без домена/SSL).
#            Пользователь копирует код из браузера и отправляет боту.
#   server — для продакшна. Нужен домен + HTTPS (см. SSL_CERT_PATH, SSL_KEY_PATH).
OAUTH_MODE=local

# HTTPS-сервер для OAuth callback (только при OAUTH_MODE=server)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8443
SSL_CERT_PATH=/path/to/fullchain.pem
SSL_KEY_PATH=/path/to/privkey.pem
